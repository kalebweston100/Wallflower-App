<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/dark_blue"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/mainTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/yellow"
            android:textSize="60sp"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/mainNotify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20sp"
            android:paddingBottom="20sp"
            android:text="@string/main_label"
            android:textAlignment="center"
            android:textColor="@color/yellow"
            android:textSize="20sp" />

        <Switch
            android:id="@+id/broadcastSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="toggleBroadcast"
            android:text="@string/broadcast_off"
            android:textAlignment="center"
            android:textColor="@color/yellow"
            android:textSize="24sp" />

        <EditText
            android:id="@+id/codeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/code_hint"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:textAlignment="center"
            android:textColor="@color/yellow"
            android:textColorHint="@color/yellow"
            android:textSize="34sp" />

        <Button
            android:id="@+id/discoverButton"
            android:layout_width="300sp"
            android:layout_height="200sp"
            android:background="@color/light_blue"
            android:onClick="discover"
            android:text="@string/discover_button"
            android:textAllCaps="false"
            android:textColor="@color/yellow"
            android:textSize="34sp"
            tools:ignore="TextContrastCheck" />

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="300sp"
            android:layout_height="200sp"
            android:background="@color/light_blue"
            android:onClick="cancelDiscover"
            android:text="@string/cancel_button"
            android:textAllCaps="false"
            android:textColor="@color/yellow"
            android:textSize="34sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>